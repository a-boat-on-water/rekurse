# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas — Connect > Drivers > Python connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="rekurse"
# Hostname of the organizer-provided Atlas Sandbox cluster; MongoStore refuses any other host (spec §5.1)
ATLAS_SANDBOX_HOST="<cluster>.xxxxx.mongodb.net"

# Embeddings: Voyage AI preferred (MongoDB-owned, free tier); falls back to OpenAI if unset
VOYAGE_API_KEY=""
# VOYAGE_MODEL="voyage-3.5"

# LLMs
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
